{% set meta = load_toml(path="src.tera/israeli/slihot.toml") %}
% include anything the user wants before the bookpart starts









\bookpart {

% this causes the variables to be defined...














% now play with the variables that depend on language



% calculate the tag line


% calculate the typesetby




\tocItem \markup "{{ meta.computed.tocname }}"





% taken from "/usr/share/lilypond/2.12.3/ly/titling-init.ly"
\markup {
	\column {
{% if meta.has.dedication %}		\fill-line { "{{ meta.attributes.dedication }}" }
{% endif %}		\override #'(baseline-skip . 3.5)
		\column {
			\huge \larger \bold
			\fill-line { \larger "{{ meta.attributes.title }}" }
{% if meta.has.subtitle %}			\fill-line { \large \smaller \bold \larger "{{ meta.attributes.subtitle }}" }
{% endif %}{% if meta.has.subsubtitle %}			\fill-line { \smaller \bold "{{ meta.attributes.subsubtitle }}" }
{% endif %}			\fill-line {
				"{{ meta.computed.fullpoet }}"
				"{{ meta.computed.fullcomposer }}"
			}
			\fill-line {
{% if meta.has.piece %}				"{{ meta.attributes.piece }}"
{% endif %}{% if meta.has.opus %}				"{{ meta.attributes.opus }}"
{% else %}				""
{% endif %}			}
		}
	}
}
\noPageBreak


% include the preparatory stuff, if there is any

% calculate the vars



% score for printing
\score {
	<<
\new ChordNames="Chords"
	\with {
		\remove "Bar_engraver"
	}
% # transpose with 'inline' is true!
	\transpose c c { {%- include "src.tera/israeli/slihot.ChordsMy.ly.tera" %}}
% this thing will only engrave voltas. This is required to put the volta under the chords.
% No great harm will happen if you don't put it, only the voltas will be above the chords.
%\new Staff \with {
%	\consists "Volta_engraver"
%}
\new Staff="Melody" {
\new Voice="Voice"
% # transpose with 'inline' is true!
	\transpose c c { \relative c'
	{% include "src.tera/israeli/slihot.VoiceMy.ly.tera" %} }
}
\new Lyrics="Lyrics" \lyricsto "Voice" {
	{% include "src.tera/israeli/slihot.LyricsMy.ly.tera" %}
}
\new Lyrics="Lyrics" \lyricsto "Voice" {
	{% include "src.tera/israeli/slihot.LyricsmoreMy.ly.tera" %}
}
	>>
	\layout {
	}
}

{% include "src.tera/israeli/slihot.Extra.ly.tera" %}

\noPageBreak
\markup \column {
	% just a little space
	\null
	\fill-line {
		\smaller \smaller { "{{ meta.computed.copyright }}" }
	}
{% if meta.has.copyrightextra %}	\fill-line {
		\smaller \smaller { "{{ meta.attributes.copyrightextra }}" }
	}
{% endif %}{% if meta.has.copyrightextraextra %}	\fill-line {
		\smaller \smaller { "{{ meta.attributes.copyrightextraextra }}" }
	}
{% endif %}
	\fill-line {
		\smaller \smaller { "Typeset by {{ meta.attributes.typesetter }}" }
	}
}



}

