}
\new Lyrics="Lyrics" \lyricsto "Voice" {
	{% set part = "LyricsReal" %}{% include "src.tera/openbook/giant_steps.ly.tera" %}
}
\new Lyrics="Lyrics" \lyricsto "Voice" {
	{% set part = "LyricsmoreReal" %}{% include "src.tera/openbook/giant_steps.ly.tera" %}
}
	>>
	\layout {
	}
}


