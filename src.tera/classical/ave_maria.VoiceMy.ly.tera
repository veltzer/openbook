



{
	\tempo "Reverently" %%4 = 130
	\time 4/4
	\key c \major

	% part "A"
	a'1 |
	bes2. bes4 |
	c2.( g4) |
	a1 |
	d2( d8 d,8) e8 f8 |
	g4.( a8) g2 |
	c2(c8 c,8) d8 e8 |
	f4.( g8) f2 |
	% Second System
	f'2( f8 f,8) g8( a8) |
	b4.( a8 g4) d4 |
	e2 r4 g4 |
	a2( a8) a8( bes8 c8) |
	d4. d,8 d2 |
	g2( g8) g8 a8( bes8) |
	c4.( c,8) c2 |
	% Third System
	f2( f8) f8( g8 a8) |
	bes2( bes8) bes8( c8 d8) |
	e4. d8 c4( g4) |
	a2. r4 |
	c2 a4( a8.) a16 |
	d2 d,4 r4 |
	d'2 f,4( d'8.) d16 |
	% Fourth System
	f2 aes,4~ aes8. f'16 |
	f2 g,4 r4 |
	g2~ g8 g8( f8) e8 |
	c'4.( a8) f2 |
	bes2( bes8) bes8 a8 g8 |
	g'4. e8 c4 r |
	d2( d8) d8 e8( f8) |
	% Fifth System
