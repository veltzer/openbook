


\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	bes1:7 | es1:7 | bes1:7 | es1:7 \myEndLine
	bes1:7 | es1:7 | bes1:7 | es1:7 \myEndLine
	\endPart


	\myMark "B"
	\startPart
	bes2 es2:/+bes | bes2:7 es2:/+bes | bes2 es2:/+bes | bes2:7 es2:/+bes \myEndLine
	bes2 bes4:/+d es4 | f1:sus7 | bes2 bes4:/+d es4 | f1:sus7 \myEndLine
	c1:m7 | d:m7 | g4:m f g:m f | g1:m \myEndLine
	\endPart

	\endSong
	\endChords
}




