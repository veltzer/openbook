


\chordmode {
	\startSong
	\startChords

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2.*4 | \myEndLine
		c2.*2:7 | f | \myEndLine
		f2. | f2 f4:7 | a2.*2 | \myEndLine
		e:7 | a2. | c2.:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2.*2 | f2.:7 | f4:7/f f:7/e f:7/ees | \myEndLine
		d2.*2:7 | c4:m g2:m | g2.:m | \myEndLine
		g:m | bes:m | f | g:9 | \myEndLine
		c2.*2:7 |
	} \alternative {
		{
			f2. | c:7 | \myEndLineVoltaNotLast
		}
		{
			f2.*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endChords
	\endSong
}


