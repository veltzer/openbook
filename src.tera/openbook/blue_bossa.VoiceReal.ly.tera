



{
	\tempo "Allegro" 4 = 150
	\time 4/4
	\key c \minor

	\partial 4 g'4 |

	% part "A"
	\repeat volta 3 {
		g'4. f8 ees d4 c8~ | c2. bes4 | aes2 g'4. f8~ | f1 |
		f4. ees8 d c4 bes8~ | bes2. aes4 | g2 f'4. ees8~ | ees1 |
		ees4. des8 c bes4 aes8~ | aes2. ges4 | ges f8 bes~ bes f aes4~ | aes1 |
		aes4 g8 bes~ bes2 | aes4 g8 bes~ bes4. aes8 |
	} \alternative
	{
		{
			g1~ | g2. g4 |
		}
		{
			g1~ | g2. r4 |
		}
	}
}



